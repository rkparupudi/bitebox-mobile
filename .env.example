# Optional in development: the app works out the API address from the Expo dev server
# (your laptop's Wi-Fi IP + port 3000). Set this to override, e.g. a staging API.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:3000

# Port of the local API when the address is worked out automatically.
# EXPO_PUBLIC_API_PORT=3000
